{
  "name": "hextra-studio",
  "version": "1.0.0",
  "description": "Hextra Studio - Desktop Discord Automation & Tools",
  "main": "dist/main/index.js",
  "author": "Hextra Studio",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "build:exe": "npm run build && electron-builder --win",
    "screenshots": "node scripts/run-capture.js && node scripts/generate-banner.js",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@dank074/discord-video-stream": "^7.0.0",
    "@lng2004/discord.js-selfbot-v13": "^3.7.2",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium": "^0.7.15",
    "libsodium-wrappers": "^0.7.15",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^6.21.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.hextrastudio.discordtools",
    "productName": "Hextra Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}